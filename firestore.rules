rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /friend_progress/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) && validParticipant(request.resource.data);
      allow delete: if request.auth != null;
    }

    match /friend_progress_debug/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) && validParticipant(request.resource.data);
      allow delete: if request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validParticipant(data) {
      return data.keys().hasOnly([
          'displayName',
          'affinity',
          'distanceMiles',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'displayName',
          'affinity',
          'distanceMiles',
          'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.trim().size() > 0
        && data.displayName.size() <= 60
        && data.affinity in [
          'woodland',
          'river',
          'hills',
          'coast',
          'cottage'
        ]
        && data.distanceMiles is number
        && data.distanceMiles >= 0
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }
  }
}
